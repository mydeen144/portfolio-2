{
  "framework": null,
  "installCommand": "",
  "buildCommand": "",
  "outputDirectory": ".",
  "cleanUrls": true,
  "redirects": [
    { "source": "/blog", "destination": "/#l-notes", "permanent": true },
    { "source": "/blog/:path*", "destination": "/#l-notes", "permanent": true },
    { "source": "/projects", "destination": "/#l-work", "permanent": true },
    { "source": "/projects/:path*", "destination": "/#l-work", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(assets|vendor|images)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/llms.txt",
      "headers": [{ "key": "Content-Type", "value": "text/markdown; charset=utf-8" }]
    }
  ]
}
